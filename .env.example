# Copy to .env and adjust. docker-compose.yml reads SECRET_KEY from here;
# the other variables shown are set directly in docker-compose.yml per
# service and are listed here for reference when running a service
# standalone (outside Docker).
#
# SECRET_KEY specifically is shared by TWO services, not just auth: the
# gateway verifies every request's JWT locally against this same value
# (see services/gateway/app/security.py) rather than calling auth over
# the network on every single request. Change this in real use and it
# changes for both -- docker-compose.yml wires the identical env var to
# each. Setting it for one and not the other breaks every authenticated
# request platform-wide.
SECRET_KEY=change-me-to-something-random-in-real-use

# "local" lets the built-in dev secret through so `docker compose up` works with
# no .env at all. Anything else (the default when unset in a standalone run)
# makes auth and gateway REFUSE TO START unless SECRET_KEY is a real value of at
# least 32 bytes. Use "production" for any shared or internet-reachable stack.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ICOP_ENV=local

# First admin. POST /auth/register only ever creates viewers, and the gateway
# restricts deployments, infrastructure, incidents etc. to operator/admin, so
# without this nobody can use them. Created on auth start-up if absent (idempotent);
# the password must satisfy the normal password rules or auth fails loudly.
# Afterwards, admins promote others with PATCH /api/v1/auth/users/{id}/role.
# Remove the password from the environment once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Console (docker-compose): written to /config.json at container start. Leave a
# value empty to hide that link/badge.
ICOP_ENVIRONMENT_LABEL=local
ICOP_GRAFANA_URL=http://localhost:3000
ICOP_API_DOCS_URL=http://localhost:8000/docs
ICOP_SUPPORT_EMAIL=

# Grafana (docker-compose only; anonymous access is off).
GRAFANA_ADMIN_PASSWORD=admin

# --- auth service (standalone) ---
DATABASE_URL=postgresql+psycopg2://icop:icop@localhost:5432/icop
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# also reads AUDIT_SERVICE_URL (below)

# --- gateway (standalone) ---
AUTH_SERVICE_URL=http://localhost:8001
DEPLOYMENT_SERVICE_URL=http://localhost:8002
INCIDENT_SERVICE_URL=http://localhost:8003
ALERT_SERVICE_URL=http://localhost:8004
AIOPS_SERVICE_URL=http://localhost:8005
ANALYTICS_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
AUDIT_SERVICE_URL=http://localhost:8008
INFRASTRUCTURE_SERVICE_URL=http://localhost:8009
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- incident service (standalone) ---
# also reads DATABASE_URL and AUDIT_SERVICE_URL (already above)

# --- deployment service (standalone) ---
CELERY_BROKER_URL=amqp://icop:icop@localhost:5672//
CHART_PATH=../../infra/helm/service-chart
HEALTH_CHECK_TIMEOUT_SECONDS=60
# also reads AUDIT_SERVICE_URL (below)

# --- alert service (standalone) ---
PROMETHEUS_URL=http://localhost:9090
EVALUATION_INTERVAL_SECONDS=30
# also reads DATABASE_URL, CELERY_BROKER_URL, INCIDENT_SERVICE_URL,
# NOTIFICATION_SERVICE_URL, and AUDIT_SERVICE_URL (already above)

# --- aiops service ---
# Required for POST /ai/explain to work -- everything else (health,
# metrics, history) works without it. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- notification service ---
# Optional -- omit to leave the "email" channel unregistered (webhook
# still works without any of these).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=icop@example.com

# --- infrastructure service ---
# Required for POST /environments to get past `terraform init` --
# everything else (health, metrics, list/get) works without it. Use an
# IAM user/role with, at minimum: EC2, EKS, RDS, ElastiCache, S3, IAM
# (role/policy management), and STS permissions -- see
# terraform/README.md for exactly what gets created. Never commit real
# values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# also reads DATABASE_URL, CELERY_BROKER_URL, and AUDIT_SERVICE_URL
# (already above); TERRAFORM_ROOT/ANSIBLE_ROOT default to paths that only
# resolve correctly inside the Docker image (see
# services/infrastructure/Dockerfile) -- running this service standalone
# outside Docker needs both set to real local paths, e.g.:
# TERRAFORM_ROOT=../../terraform
# ANSIBLE_ROOT=../../ansible
